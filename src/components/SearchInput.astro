---
/**
 * SearchInput - Inline search input for filtering lists and tables
 * A compact, styled search input with search icon
 *
 * Styling lives in admin/controls.css (single source of truth) — this
 * component must not carry a scoped <style>.
 */
export interface Props {
  id: string;
  name?: string;
  placeholder?: string;
  value?: string;
  disabled?: boolean;
  class?: string;
  /** Size variant */
  size?: 'default' | 'sm' | 'lg';
}

const {
  id,
  name = id,
  placeholder = 'Rechercher...',
  value = '',
  disabled = false,
  class: className = '',
  size = 'default',
} = Astro.props;

const inputClass = ['search-input', `search-input-${size}`, className].filter(Boolean).join(' ');
---

<div class="search-input-wrapper">
  <span class="search-icon" aria-hidden="true">&#x1F50D;</span>
  <input
    type="search"
    id={id}
    name={name}
    placeholder={placeholder}
    value={value}
    disabled={disabled}
    class={inputClass}
  />
</div>
