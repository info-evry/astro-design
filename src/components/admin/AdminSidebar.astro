---
/**
 * AdminSidebar - Vertical navigation sidebar for admin panels
 *
 * Renders `role="tab"` buttons meant to be driven by `scripts/tabs.ts`
 * (`initTabs`, `switchTab`, `setTabBadge`). All styling lives in
 * `admin/layout.css` (single source of truth) — this component must not
 * carry a scoped `<style>` because its class names (`admin-sidebar-item`,
 * `admin-sidebar-icon`, `admin-sidebar-badge`, ...) are also produced by
 * hand-written markup and by JS templates (see scripts/templates.ts) that
 * rely on the global rules.
 *
 * Contract:
 * - Each tab renders as
 *   `<button type="button" role="tab" class="admin-sidebar-item [active]"
 *      data-tab={id} aria-controls="panel-{id}">`
 * - The icon (if provided) is looked up via `getSymbol()` and rendered in
 *   `<span class="admin-sidebar-icon sf-symbol">`.
 * - The badge (if `badge` is set) renders as
 *   `<span id="{id}-badge" class="admin-sidebar-badge [hidden]">` so that
 *   `scripts/tabs.ts#setTabBadge(id, count)` can update it by ID.
 *
 * @prop {Array<{id: string, label: string, icon?: string, badge?: number|string, badgeHidden?: boolean}>} tabs - Navigation tabs
 * @prop {string} [activeTab] - Initially active tab ID
 * @prop {string} [id='admin-sidebar'] - Container ID
 */
import { getSymbol } from '../../utils/symbols';

interface Tab {
  id: string;
  label: string;
  icon?: string;
  badge?: number | string;
  badgeHidden?: boolean;
}

interface Props {
  tabs: Tab[];
  activeTab?: string;
  id?: string;
}

const { tabs, activeTab = tabs[0]?.id, id = 'admin-sidebar' } = Astro.props;
---

<nav class="admin-sidebar" id={id}>
  <ul class="admin-sidebar-nav">
    {tabs.map((tab) => (
      <li>
        <button
          type="button"
          role="tab"
          class:list={['admin-sidebar-item', { active: tab.id === activeTab }]}
          data-tab={tab.id}
          aria-controls={`panel-${tab.id}`}
          aria-selected={tab.id === activeTab}
        >
          {tab.icon && <span class="admin-sidebar-icon sf-symbol">{getSymbol(tab.icon)}</span>}
          <span class="admin-sidebar-label">{tab.label}</span>
          {tab.badge !== undefined && (
            <span
              id={`${tab.id}-badge`}
              class:list={['admin-sidebar-badge', { hidden: tab.badgeHidden }]}
            >
              {tab.badge ?? 0}
            </span>
          )}
        </button>
      </li>
    ))}
  </ul>
</nav>
